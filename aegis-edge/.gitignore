# --- Node / Edge Impulse CLI ---
node_modules/
# Local EI project exports / config dumps (keep the canonical .zip out of git history)
ei-*.json

# --- Build outputs / firmware binaries ---
build/
*.bin
*.hex
*.s37
*.axf
*.o

# --- Simplicity Studio 5 / Gecko SDK build artifacts ---
GNU ARM v*/
autogen/

# --- Python tooling (helper scripts) ---
__pycache__/
*.pyc
.venv/

# --- OS cruft ---
.DS_Store

# --- Private workspace (daily logs, scratch notes) ---
scratch-pad/

# --- Demo media: ignore only the raw videos, NOT the committed screenshots/stills ---
# (the demo/ folder keeps screenshots/ + frames/ PNGs in git; videos stay out -- see
# the root .gitignore and demo/SHOT-LIST.md)
demo/*.mp4
demo/*.mov
demo/*.m4v