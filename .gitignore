# ============================================================
# Thunderboard Labs — repo-wide ignore rules
# ============================================================

# --- Node / Edge Impulse CLI ---
node_modules/
# Local EI project exports / config dumps (keep the canonical .zip out of history)
ei-*.json

# --- Build outputs / firmware binaries ---
build/
*.bin
*.hex
*.s37
*.axf
*.o

# --- Simplicity Studio 5 / Gecko SDK build artifacts ---
GNU ARM v*/
autogen/

# --- Python tooling (helper scripts) ---
__pycache__/
*.pyc
.venv/
.pytest_cache/
.ruff_cache/

# --- Demo media (kept OUT of git history to avoid binary bloat) ---
# Raw demo videos live in aegis-edge/demo/ locally; git stores only the
# SHOT-LIST + screenshots. See aegis-edge/demo/SHOT-LIST.md for where the
# actual .mp4 files are kept. If they ever need to ship in-repo, use Git LFS
# or attach them as GitHub Release assets rather than committing raw.
*.mp4
*.mov
*.m4v

# --- OS cruft ---
.DS_Store

# --- Local tooling state (gstack browser audit, etc.) ---
.gstack/

# --- Private workspace (daily logs, scratch notes) ---
scratch-pad/
